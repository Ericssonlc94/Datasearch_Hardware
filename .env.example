# Copie para .env e ajuste conforme necessário. Todas as variáveis são opcionais.
# Nenhuma fonte usada por este projeto exige chave de API.

DSH_HOST=127.0.0.1
DSH_PORT=8000

# Ciclo de atualização do painel, em segundos (padrão: 900 = 15 minutos).
DSH_REFRESH_SECONDS=900
# Intervalo mínimo entre coletas forçadas pelo botão "atualizar" (POST /api/refresh).
# DSH_REFRESH_MIN_INTERVAL_SECONDS=60

# Valores aceitos no header Host, separados por vírgula (proteção contra DNS
# rebinding). Se usar DSH_HOST=0.0.0.0, inclua aqui o IP/nome da máquina na rede.
# DSH_ALLOWED_HOSTS=127.0.0.1,localhost
# Cache das manchetes, em segundos (padrão: 1800 = 30 minutos).
# DSH_TTL_NEWS=1800

# Contato do responsável (e-mail ou URL do repositório), enviado no User-Agent
# para a fonte poder falar com você. Opcional.
DSH_CONTACT=
# Preço na KaBuM: 1 pedido por produto a cada 24 h, que nem o botão
# "atualizar" fura; uma falha da loja fica guardada 24 h.
# DSH_ENABLE_KABUM=false

# Desligue fontes individuais se a sua rede bloquear o domínio.
# DSH_ENABLE_MARKETS=false      # Yahoo Finance
# DSH_ENABLE_NEWS_RSS=false     # feeds RSS de veículos de notícia e análise
# DSH_ENABLE_USGS=false         # earthquake.usgs.gov (terremotos perto de fábricas)
# DSH_ENABLE_FEDREG=false       # federalregister.gov (regras de exportação de chips do BIS)
# DSH_ENABLE_COMTRADE=false     # comtradeapi.un.org
# DSH_ENABLE_COMTRADE_MONTHLY=false  # comtradeapi.un.org, importação mensal por SH6 (substitui o Comex Stat)
# DSH_ENABLE_FRED=false         # fred.stlouisfed.org
# DSH_ENABLE_SEC=false          # data.sec.gov (XBRL, aba Fila)

# Comex Stat: rejeitado. O WAF responde 429 a todo POST, mesmo após pausa, e a
# fonte exigia headers de origem forjados (removidos). A importação mensal vem
# do UN Comtrade (DSH_ENABLE_COMTRADE_MONTHLY).
# DSH_ENABLE_COMEXSTAT=false

# Histórico (SQLite). 30 dias em 15 min + 2 anos em base diária.
# DSH_HISTORY_PATH=data/history.db
# Cache das fontes (SQLite). Ao reabrir o app, o que ainda está no prazo é
# reaproveitado sem nova busca.
# Precisa terminar em .db e ser diferente do DSH_HISTORY_PATH; senão o app não
# sobe (um cache ilegível é movido para .corrompido-*, e isso não pode atingir
# outro arquivo).
# DSH_CACHE_PATH=data/cache.db
# DSH_HISTORY_RETENTION_DAYS=30
# DSH_HISTORY_DAILY_RETENTION_DAYS=730


# Timeout e retentativas por requisição externa.
DSH_HTTP_TIMEOUT=20
DSH_HTTP_RETRIES=2
