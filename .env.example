# Copie para .env e ajuste conforme necessário. Todas as variáveis são opcionais.
# Nenhuma fonte usada por este projeto exige chave de API.

DSH_HOST=127.0.0.1
DSH_PORT=8000

# Ciclo de atualização do painel, em segundos (padrão: 900 = 15 minutos).
DSH_REFRESH_SECONDS=900

# Desligue fontes individuais se a sua rede bloquear o domínio.
# DSH_ENABLE_MARKETS=false      # Yahoo Finance / Stooq
# DSH_ENABLE_GDELT=false        # api.gdeltproject.org
# DSH_ENABLE_COMTRADE=false     # comtradeapi.un.org
# DSH_ENABLE_COMEXSTAT=false    # api-comexstat.mdic.gov.br
# DSH_ENABLE_FRED=false         # fred.stlouisfed.org


# Timeout e retentativas por requisição externa.
DSH_HTTP_TIMEOUT=20
DSH_HTTP_RETRIES=2
